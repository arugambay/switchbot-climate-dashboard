# Kopiere diese Datei nach .env (lokal) bzw. trage die Werte in Streamlit Cloud unter "Secrets" ein.
# Ohne diese Werte läuft die App im lokalen Entwicklungsmodus (SQLite-Datei unter data/).

# Supabase-Projekt-URL, z. B. https://abcdefgh.supabase.co
SUPABASE_URL=
# Öffentlicher "anon"/"publishable" Schlüssel (darf im Browser stehen, Zugriff wird über RLS geschützt)
SUPABASE_ANON_KEY=
# Öffentliche Basis-URL der App für Freigabelinks, z. B. https://mein-klima.streamlit.app
APP_BASE_URL=
# Zeitzone der Sensoren (Standard)
DEFAULT_TIMEZONE=Europe/Berlin

# WICHTIG: Den Supabase "service_role"-Schlüssel NIEMALS hier oder in Streamlit eintragen.
# Die App benötigt ihn nicht.
